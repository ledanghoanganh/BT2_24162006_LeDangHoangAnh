# ===================================================
# CẤU HÌNH GỬI EMAIL XÁC THỰC OTP (SMTP)
# ===================================================
# Hướng dẫn:
# 1. Sao chép file này và đổi tên thành '.env' ở cùng thư mục
# 2. Điền mật khẩu SMTP mới của bạn vào dòng SMTP_PASSWORD bên dưới
# 3. File '.env' đã được bảo vệ bởi .gitignore, KHÔNG bị đẩy lên GitHub

SMTP_HOST=smtp.tino.vn
SMTP_PORT=587
SMTP_FROM_EMAIL=van.a.789@hc.io.vn
SMTP_PASSWORD=your_email_password_here
SMTP_SENDER_NAME=Web Bán Hàng - Xác thực
